DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=gogather

# Signs the session cookie -- required, the app refuses to start without it.
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Werkzeug's interactive debugger is a remote-code-execution risk if it's
# ever reachable from outside your own machine -- leave this unset (or 0)
# anywhere but local development.
FLASK_DEBUG=0

# eSewa -- leave unset to use their published sandbox test credentials
# (already the default in app.py). Replace with real merchant credentials
# before going live.
# ESEWA_PRODUCT_CODE=
# ESEWA_SECRET_KEY=
# In production the sandbox key is refused (it is public). Set to 1 only for a
# demo site that never takes real money.
# ESEWA_ALLOW_SANDBOX=0

# Stripe -- required for card payments to work at all.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# NPR->USD rate used only for the Stripe (card) payment amount.
NPR_PER_USD=133

# ---------------------------------------------------------------------------
# Production settings -- see DEPLOYMENT.md. Run `python manage.py check` to
# see what is still missing before you go live.
# ---------------------------------------------------------------------------

# "production" turns on Secure session cookies and HSTS. Leave as
# "development" on your own machine (Secure cookies don't work over http://).
APP_ENV=development

# Minutes of inactivity before a signed-in session expires.
# SESSION_LIFETIME_MINUTES=120

# The public address of the site, used to build links inside emails.
APP_BASE_URL=http://localhost:5000

# Set to 1 ONLY when the app sits behind exactly one reverse proxy (nginx,
# a load balancer) so the real visitor IP is used for rate limiting.
TRUST_PROXY=0

# Email (password-reset codes, booking/payment/refund notices, trip reminders,
# support replies). Without SMTP_HOST nothing is sent -- in development the
# message is written to logs/gogather.log instead.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls        # starttls | ssl | none
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=GoGather <no-reply@example.com>

# Shown in the Help Centre.
# SUPPORT_EMAIL=support@example.com

# Only for `python manage.py backup` when mysqldump isn't on your PATH.
# MYSQLDUMP_PATH=C:/xampp/mysql/bin/mysqldump.exe
